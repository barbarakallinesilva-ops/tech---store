
/* CONFIGURACAO GERAL */
body {
    font-family: Arial, sans-serif;
    background-color: #f4f7fc;
    margin: 0;
    color: #222;
}

/* MENU */
.navbar {
    background-color: #0d3b66;
    padding: 20px;
}

.navbar h2 {
    color: white;
    font-weight: bold;
    margin: 0;
}

.navbar a {
    color: white;
    text-decoration: none;
    margin-left: 25px;
}

/* APRESENTACAO */
.inicio {
    background-color: #71a2d0;
    text-align: center;
    padding: 70px 20px;
    margin-top: 30px;
    border-radius: 12px;
}

.inicio h1 {
    color: #660d2b;
    font-size: 36px;
}

.inicio p {
    font-size: 18px;
    margin: 20px 0;
}

/* BOTOES */
button {
    background-color: #0d3b66;
    color: white;
    border: none;
    padding: 12px 22px;
    border-radius: 6px;
    cursor: pointer;
}

button:hover {
    background-color: #1769aa;
}

/* PRODUTOS */
.produtos {
    margin-top: 50px;
    margin-bottom: 50px;
}

.produtos h2 {
    color: #0d3b66;
    margin-bottom: 25px;
    text-align: center;
}

.card {
    background-color: white;
    border: none;
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 25px;
    text-align: center;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
}

.card img {
    width: 100%;
    height: 200px;
    object-fit: contain;
    margin-bottom: 15px;
}

.card h3 {
    color: #0d3b66;
    font-size: 22px;
}

.card p {
    margin: 10px 0;


/* BARRA DE PESQUISA */
.pesquisa {
    display: flex;
    gap: 10px;
    margin-top: 30px;
}

.pesquisa input {
    flex: 1;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
}

/* CATEGORIAS */
.categorias {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 20px;
}

.categorias button {
    background-color: white;
    color: #0d3b66;
    border: 1px solid #0d3b66;
}

.categorias button:hover {
    background-color: #0d3b66;
    color: white;
}

}

/* ORGANIZACAO DO MENU */
.navbar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.menu-links {
    display: flex;
    align-items: center;
    gap: 25px;
}

.menu-links a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.menu-links a:hover {
    color: #a9d6ff;
}

/* AJUSTE PARA CELULARES */
@media (max-width: 768px) {
    .navbar .container {
        flex-direction: column;
        gap: 15px;
    }

    .menu-links {
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }
}

